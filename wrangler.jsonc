{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ouvidoria-painel",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ouvidoria-painel",
      "database_id": "aa8353b9-a2a2-439f-9f0e-aff66e5c937f",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://tiforest.github.io"
  },
  "observability": {
    "enabled": true
  }
}
