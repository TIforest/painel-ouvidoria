{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ouvidoria-painel",
  "account_id": "ecc2e58aa45d10954dccbf42fd4d45ee",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ouvidoria-painel",
      "database_id": "87f8c432-efe4-4769-adb9-4653bcdfe185",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://tiforest.github.io"
  },
  "observability": {
    "enabled": true
  }
}
